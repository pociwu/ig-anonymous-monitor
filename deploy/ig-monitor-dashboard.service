[Unit]
Description=IG Monitor read-only dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/ig-monitor
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/miniconda3/envs/ig-monitor/bin/python -m ig_monitor.dashboard --db /srv/ig-monitor/data/state.sqlite3 --host 0.0.0.0 --port 8888
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
